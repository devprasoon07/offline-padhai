<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline PadhAI — main screen.
  Minimal chrome: full-bleed preview, chhota wordmark, floating capture button.
  Result bottom sheet me: drag handle, question card, streaming answer, pill follow-up.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Full-bleed camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Top bar: chhota wordmark + History/Quiz buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvWordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.3"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/wordmark"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHistory"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_history"
            android:textSize="12sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuiz"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/btn_quiz"
            android:textSize="12sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Floating capture button, subtle ring -->
    <ImageButton
        android:id="@+id/btnCapture"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="152dp"
        android:background="@drawable/capture_button"
        android:contentDescription="@string/capture_desc"
        android:elevation="6dp" />

    <!-- Result bottom sheet -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/sheet_background"
        android:elevation="8dp"
        android:fillViewport="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="128dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Drag handle -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/drag_handle" />

            <!-- Peek: status / hint -->
            <TextView
                android:id="@+id/tvSheetHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/sheet_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- OCR progress -->
            <ProgressBar
                android:id="@+id/progressOcr"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/accent_amber"
                android:visibility="gone" />

            <!-- Expanded: result content -->
            <LinearLayout
                android:id="@+id/resultContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuestionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.15"
                    android:text="@string/question_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Sawal card + mic button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardQuestion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/surface_card"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/divider"
                        app:strokeWidth="1dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:drawableStart="@android:drawable/ic_menu_search"
                            android:drawablePadding="10dp"
                            android:hint="@string/question_hint"
                            android:inputType="textMultiLine"
                            android:lineSpacingExtra="4sp"
                            android:minLines="2"
                            android:padding="16dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_faint"
                            android:textSize="16sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <ImageButton
                        android:id="@+id/btnMic"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_background"
                        android:contentDescription="@string/mic_desc"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_btn_speak_now" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExplain"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_explain"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    app:backgroundTint="@color/accent_amber"
                    app:cornerRadius="16dp" />

                <!-- Bhasha chunao -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lang_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/spinnerLanguage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Thinking row -->
                <LinearLayout
                    android:id="@+id/rowThinking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/answerProgress"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/accent_amber" />

                    <TextView
                        android:id="@+id/tvExplaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/explaining"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Streaming answer -->
                <TextView
                    android:id="@+id/tvAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="7sp"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- Answer actions: bookmark / suno / share -->
                <LinearLayout
                    android:id="@+id/rowAnswerActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnBookmark"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/pill_background"
                        android:contentDescription="@string/bookmark_desc"
                        android:padding="10dp"
                        android:src="@android:drawable/btn_star_big_off" />

                    <ImageButton
                        android:id="@+id/btnSpeak"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_background"
                        android:contentDescription="@string/speak_desc"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_media_play" />

                    <ImageButton
                        android:id="@+id/btnShare"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_background"
                        android:contentDescription="@string/share_desc"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_share" />
                </LinearLayout>

                <!-- Hairline divider -->
                <View
                    android:id="@+id/dividerFollow"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/divider"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvFollowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/followup_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Follow-up: minimal pill -->
                <LinearLayout
                    android:id="@+id/followRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etFollowUp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/pill_background"
                        android:hint="@string/followup_hint"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_faint"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/send_desc"
                        android:text="@string/btn_send"
                        android:textColor="@color/on_accent"
                        android:textSize="14sp"
                        app:backgroundTint="@color/accent_amber"
                        app:cornerRadius="24dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAirplaneHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/airplane_hint"
                    android:textColor="@color/text_faint"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Setup guidance: model file missing -->
            <LinearLayout
                android:id="@+id/cardSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSetupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/setup_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSetupBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="5sp"
                    android:text="@string/setup_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecheck"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_recheck"
                    android:textColor="@color/accent_amber"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
