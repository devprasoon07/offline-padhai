<?xml version="1.0" encoding="utf-8"?>
<!-- Floating capture button: amber dot, subtle ring. Koi flashy glow nahi. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent_amber_soft" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent_amber" />
        </shape>
    </item>
</layer-list>
